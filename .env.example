# ─────────────────────────────────────────────────────────────────────────
# OA Événementiel — variables d'environnement de PRODUCTION
# Copier en .env (jamais commité) ou les saisir chez l'hébergeur.
# Aucune valeur réelle ici.
# ─────────────────────────────────────────────────────────────────────────

# URL publique canonique du site (SEO, sitemap, liens des emails)
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr

# Accès administrateur — OBLIGATOIRES en production (sinon connexion refusée)
# JWT_SECRET : 32 caractères minimum, ex. `openssl rand -hex 32`
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Base de données hébergée (Turso / libSQL). Sans ces variables : fichier
# local data/db.sqlite (incompatible avec un hébergement serverless).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Emails transactionnels (Resend)
RESEND_API_KEY=
EMAIL_FROM="OA Événementiel <contact@votre-domaine.fr>"

# Paiement par carte (Stripe). La clé publique peut être exposée ;
# la clé secrète et le secret webhook restent côté serveur uniquement.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mesure d'audience (facultatif) — Plausible ou instance auto-hébergée.
# Laisser vide = aucun outil chargé, aucune bannière cookies affichée.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
