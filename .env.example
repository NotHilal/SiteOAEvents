# ─────────────────────────────────────────────────────────────────────────
# OA Événementiel — configuration du serveur (VPS)
# Copier en .env à côté de docker-compose.yml (jamais commité).
# Guide complet : DEPLOIEMENT.md
# ─────────────────────────────────────────────────────────────────────────

# Domaine du site (HTTPS automatique via Caddy) et URL publique
DOMAIN=oa-evenementiel.fr
NEXT_PUBLIC_SITE_URL=https://oa-evenementiel.fr

# Base de données PostgreSQL (conteneur « db »)
# Mot de passe : uniquement lettres et chiffres, ex. `openssl rand -hex 24`
POSTGRES_DB=oa
POSTGRES_USER=oa
POSTGRES_PASSWORD=
# En dehors de Docker (développement), l'adresse complète :
# DATABASE_URL=postgres://oa:motdepasse@localhost:5432/oa

# Accès à l'administration (/admin) — OBLIGATOIRES
# JWT_SECRET : `openssl rand -hex 32`
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=
# Sessions des comptes clients (`openssl rand -hex 32`)
CUSTOMER_JWT_SECRET=
# Chiffrement des clés Stripe enregistrées dans l'admin (`openssl rand -hex 32`).
# Ne plus jamais le changer ensuite : les clés enregistrées deviendraient illisibles.
SETTINGS_ENCRYPTION_KEY=

# Paiement Stripe : se configure dans l'admin (Réglages > Paiement en ligne).
# Facultatif ici : ces variables ne servent que si rien n'est saisi dans l'admin.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# E-mails : formulaire de contact, confirmations, annulations, mot de passe
# Boîte OVH : ssl0.ovh.net, port 465, identifiant = adresse complète
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="OA Événementiel <contact@oa-evenementiel.fr>"
# Reçoit une alerte à chaque commande payée
NOTIFICATION_EMAIL=contact@oa-evenementiel.fr
# Origine des liens de réinitialisation (facultatif, sinon NEXT_PUBLIC_SITE_URL)
PASSWORD_RESET_ORIGIN=

# Numéro professionnel (format international, ex. +33612345678) — facultatif
NEXT_PUBLIC_SITE_PHONE=

# Mesure d'audience Plausible — facultatif (vide = aucun outil, aucune bannière)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_SRC=
